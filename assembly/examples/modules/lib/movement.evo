# Movement module.
# Names what it needs via .REQUIRE: a math module and the world's bounds. The lower bound
# has a default, the upper one the importer must supply; the importer satisfies both with
# a USING clause.

.REQUIRE MODULE "math.evo" AS CALC
.REQUIRE VALUE WORLD_MIN DATA:0
.REQUIRE VALUE WORLD_MAX

# Move north (Y - 1), clamped to world bounds.
EXPORT .PROC NORTH REF Y
  SUBI Y DATA:1
  CALL CALC.CLAMP REF Y VAL WORLD_MIN WORLD_MAX
  RET
.ENDPROC

# Move south (Y + 1), clamped to world bounds.
EXPORT .PROC SOUTH REF Y
  ADDI Y DATA:1
  CALL CALC.CLAMP REF Y VAL WORLD_MIN WORLD_MAX
  RET
.ENDPROC

# Move east (X + 1), clamped to world bounds.
EXPORT .PROC EAST REF X
  ADDI X DATA:1
  CALL CALC.CLAMP REF X VAL WORLD_MIN WORLD_MAX
  RET
.ENDPROC

# Move west (X - 1), clamped to world bounds.
EXPORT .PROC WEST REF X
  SUBI X DATA:1
  CALL CALC.CLAMP REF X VAL WORLD_MIN WORLD_MAX
  RET
.ENDPROC
