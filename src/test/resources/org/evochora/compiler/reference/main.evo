# Reference program of the compiler.
#
# CompilerOutputEquivalenceTest compiles it and compares the artifact with the one checked in
# next to it. CompilerFeatureSeparationTest compiles it once with every feature, and then once
# without each feature: the program as it is has to fail at a part that needs the feature, and
# the program without those parts has to compile.
#
# A part is a block that begins with a comment "#> needs:" and the features it needs, and ends
# with a comment "#<". A block names every feature it needs, and blocks do not nest. The blocks
# at the top each use one feature alone, as far as the feature stands alone; the blocks below
# join the features whose abilities only work together. What stands outside every block, the
# comments, the empty lines and the statement separator, compiles without any feature.
#
# The flags ROWS = 4 and VERBOSE and the values GAP = DATA:3 and SPAN = (SIZE * 2) are set by
# the configuration the tests compile with. Without .ORG the code runs along row 0; the blocks
# that move the cursor send it to rows of their own, and the molecules are placed from column
# 600 on, so that leaving a block out moves nothing onto another cell.

;;

# ---------------------------------------------------------------------------------------------
# Each feature alone
# ---------------------------------------------------------------------------------------------

#> needs: instruction
SETI %DR0 DATA:1
SETV %DR1 1|0
ADDR %DR0 %DR2
NOP; NOP
#<

#> needs: label
FIRST:
EXPORT SECOND:
#<

#> needs: reg
.REG %COUNT %DR3
.REG %SPOT %LR0
#<

#> needs: constdir
.CONST LIMIT DATA:7
.CONST STEP 1|0
.CONST ALSO LIMIT
#<

#> needs: macro
.MACRO NOTHING
.ENDMACRO
.MACRO IGNORES A B
.ENDMACRO
NOTHING
IGNORES 1 2
#<

#> needs: conditional
.DEFINE LEVEL 2
.DEFINE COPY LEVEL
.DEFINE MARK
.IFDEF LEVEL = 2
.ELSEIFDEF LEVEL > 5
.ELSEIFNDEF MISSING
.ELSEDEF
.ENDDEF
.IFNDEF MISSING
.ENDDEF
.IFDEF LEVEL <> 1
.ENDDEF
.IFDEF LEVEL < 3
.ENDDEF
.IFDEF LEVEL <= COPY
.ENDDEF
.IFDEF LEVEL >= 2
.ENDDEF
.IFDEF VERBOSE
.ENDDEF
.IFDEF ROWS = 4
.ENDDEF
.UNDEF MARK
#<

#> needs: repeat, instruction
.REPEAT 2
  NOP
.ENDREPEAT
.REPEAT ROWS
  NOP
.ENDREPEAT
NOP^3
NOP^ROWS
#<

#> needs: org
.ORG 0|20
.ORG 0|@+2
.ORG @+0|@-1
#<

#> needs: dir
.DIR 0|1
.DIR @+0|1
.DIR 1|0
#<

#> needs: place
.PLACE DATA:1 600|1
.PLACE STRUCTURE:2 600..610|2
.PLACE DATA:3 600..602|3..4
.PLACE DATA:4 600:2:610|5
.PLACE DATA:5 620|6, 621|6
.PLACE DATA:6 1000|*
.PLACE DATA:10 -1..2|-1
#<

#> needs: proc, label
.PROC IDLE
.ENDPROC
.PROC TAKES_ALL REF R VAL V LREF L LVAL LV
.ENDPROC
#<

#> needs: control, label
.CONTROL LINGER
.CASE AGAIN
.ENDCONTROL
#<

#> needs: importdir, ctx
.REQUIRE VALUE GAP
.IMPORT "lib/helper.evo" AS HELPER
.IMPORT "lib/module.evo" AS SUPPLY USING MODULE HELPER AS HELP VALUE COUNT DATA:2
#<

#> needs: source, ctx
.SOURCE "lib/text.evo"
#<

# ---------------------------------------------------------------------------------------------
# Features that work together
# ---------------------------------------------------------------------------------------------

#> needs: label, instruction
JMPI FIRST
JMPI SECOND
#<

#> needs: reg, instruction
SETI %COUNT DATA:2
#<

#> needs: constdir, instruction
SETI %DR0 LIMIT
SETV %DR1 STEP
ADDI %DR0 ALSO
#<

#> needs: macro, instruction
.MACRO BUMP REG AMOUNT
  ADDI REG AMOUNT
.ENDMACRO
BUMP %DR0 DATA:1
#<

#> needs: conditional, instruction
.IFDEF LEVEL = 2
  NOP
.ELSEDEF
  SETI %DR0 DATA:99
.ENDDEF
#<

#> needs: conditional, repeat, instruction
.REPEAT LEVEL
  NOP
.ENDREPEAT
NOP^LEVEL
#<

#> needs: proc, instruction, label
.PROC WORK REF R VAL V LREF L LVAL LV
  ADDR R V
  RET
.ENDPROC
CALL WORK REF %DR0 VAL DATA:1 LREF %LR0 LVAL %LR1
CALL WORK REF %DR0 VAL %DR1 LREF %LR0 LVAL %LR1
#<

#> needs: proc, instruction, reg, label
.PROC LOCAL REF R
  .REG %TMP %PDR0
  SETR %TMP R
  RET
.ENDPROC
CALL LOCAL REF %COUNT
#<

#> needs: proc, instruction, label
CALL WORK REF %DR0 VAL DATA:1 LREF %LR0 LVAL FIRST
.PROC GUARDED REF R
  IFI R DATA:0
    RET
  ADDI R DATA:1
  RET
.ENDPROC
LTI %DR0 DATA:7
  CALL GUARDED REF %DR0
#<

#> needs: proc, instruction, label, constdir
CALL WORK REF %DR0 VAL LIMIT LREF %LR0 LVAL %LR1
#<

#> needs: control, instruction, label
.CONTROL COUNTDOWN
  IFI %DR0 DATA:0
    JMPI END
  JMPI BODY
.CASE BODY
  SUBI %DR0 DATA:1
  .CONTROL CHECK
    IFI %DR1 DATA:7
      JMPI COUNTDOWN.END
  .ENDCONTROL
  JMPI COUNTDOWN
.ENDCONTROL
#<

#> needs: importdir, ctx, label, instruction
JMPI SUPPLY.ENTRY
#<

#> needs: importdir, ctx, proc, instruction, label
CALL SUPPLY.SERVE REF %DR0
CALL SUPPLY.INNER.FORWARD REF %DR0
CALL HELPER.CLAMP REF %DR0 VAL DATA:0 DATA:5
#<

#> needs: importdir, ctx, constdir
.CONST VIA SUPPLY.TOTAL
.CONST DEEP SUPPLY.INNER.INNER_VALUE
#<

#> needs: importdir, ctx, control, instruction, label
JMPI SUPPLY.GATE
JMPI SUPPLY.GATE.OPEN
#<

#> needs: source, ctx, constdir, instruction
SETI %DR0 SOURCED
#<

#> needs: constdir, place
.PLACE LIMIT 600|10
#<

#> needs: constdir, dir
.DIR STEP
#<

#> needs: dir, instruction
.DIR 0|1
  NOP; NOP
.DIR @-0|1
  NOP
.DIR 1|0
  NOP
#<

#> needs: constdir, expression
.CONST SIZE 6
.CONST AREA (SIZE * SIZE)
.CONST UNIT ENERGY:50
.CONST TWICE (2 * UNIT)
.CONST CORNER (SIZE|SIZE + 1)
.CONST KIND TYPE(UNIT)
.CONST AMOUNT NUMBER(TWICE)
.CONST SECOND_PART CORNER[1]
.CONST BITS ((0xF0 OR 0x0F) SHL 1)
.CONST MIXED ((7 AND 3) XOR (1 SHR 0))
.CONST INVERTED (NOT 0)
.CONST QUOTIENT (-7 / 2)
.CONST REST (-7 MOD 2)
.CONST DIFFERENCE (AREA - SIZE)
.CONST NEGATED (-CORNER)
.CONST TYPED KIND:AMOUNT
.CONST PARTS SIZE|(SIZE + 1)
#<

#> needs: instruction, expression
SETI %DR0 DATA:(1 + 2)
SETV %DR1 (2 * (1|0))
#<

#> needs: constdir, expression, instruction
SETI %DR0 DATA:AREA
SETI %DR1 TWICE
SETV %DR2 CORNER
SETI %DR3 TYPED
SETV %DR4 PARTS
#<

#> needs: repeat, instruction, expression
.REPEAT (ROWS - 2)
  NOP
.ENDREPEAT
NOP^(ROWS / 2)
#<

#> needs: conditional, expression
.DEFINE HALF (LEVEL / 2)
.IFDEF (HALF + 1) = 2
.ENDDEF
.IFDEF (LEVEL * 2)
.ENDDEF
#<

#> needs: org, expression
.ORG 0|(30 + 10)
.ORG (@ + (0|2))
.ORG 0|(@[1] + 2)
#<

#> needs: org, label, expression, instruction
.ORG 0|50
MARK_ROW:
  NOP
.ORG (MARK_ROW + (0|2))
#<

#> needs: place, expression, label
.PLACE DATA:7 (FIRST + (600|8))
#<

#> needs: place, expression
.PLACE DATA:(2 * 4) 600|(10 + 2)
.PLACE DATA:9 POSITION(600|13)
#<

#> needs: importdir, ctx, expression, constdir
.REQUIRE VALUE SPAN
.REQUIRE VALUE DEPTH (SIZE - 1)
.CONST WIDE (SPAN + DEPTH)
#<

#> needs: importdir, ctx, expression, constdir, place
.IMPORT "lib/positions.evo" AS SPOTS USING VALUE CORNER POSITION(640|20) VALUE WIDTH (SIZE + 1)
#<

#> needs: constdir, expression, place
.CONST HERE @
.PLACE DATA:12 (HERE + (0|35))
#<

#> needs: constdir, expression, label, place
.CONST STRETCH (SECOND - FIRST)
.PLACE DATA:STRETCH[0] 600|14
#<

#> needs: importdir, ctx, expression, constdir, place, label, org, instruction
.PLACE DATA:11 (SPOTS.INSIDE + (0|2))
#<

#> needs: org, expression, instruction
.ORG POSITION(0|60)
  NOP
#<
