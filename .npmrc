# npm's cache stays in the project, not in the user's home directory
cache=.gradle/npm-cache
# Install scripts run third-party code on every install. package.json's allowScripts denies the
# two the packages bring (esbuild and vitest work without them); a package with an install script
# allowScripts does not name stops the install until someone decides on it
strict-allow-scripts=true
# The funding appeal and the notice of a newer npm say nothing about this build: npm comes with
# the Node version build.gradle.kts pins, and is updated with it
fund=false
update-notifier=false
