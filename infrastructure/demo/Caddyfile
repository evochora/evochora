{$DOMAIN_NAME}

# The homepage of evochora.org is no part of the node: Caddy delivers it from the directory the
# deployment copies beside this file. Whatever lies in that directory is served under its name, and
# every other request goes to the node. The homepage is the index.html there, so it also stands in
# place of the start page of the node, which the demo does not show.
@site file {
    root /srv/site
    try_files {path} {path}/index.html
}
handle @site {
    root * /srv/site
    file_server
}

# Nobody controls the pipeline of the demo from outside: a request to the pipeline that is not a
# read is refused.
@control {
    path /pipeline/api/*
    not method GET HEAD
}
respond @control 403

# Reverse proxy all other requests to the evochora service on port 8081.
# Caddy will automatically handle HTTP to HTTPS redirection.
reverse_proxy evochora:8081

# The access log. A line holds the time, the address of the visitor shortened by its last part,
# the request, the status, the browser and the page the visitor came from; every other header of
# the request is left out. Caddy starts a new file a day and keeps a file for five days. The file
# lies in a directory of the server, so that it outlasts a deploy.
log_append browser {http.request.header.User-Agent}
log_append referrer {http.request.header.Referer}
log {
    output file /var/log/caddy/access.log {
        mode 644
        roll_interval 24h
        roll_keep_for 120h
    }
    format filter {
        request>remote_ip ip_mask 24 48
        request>client_ip ip_mask 24 48
        request>headers delete
        request>tls delete
        resp_headers delete
    }
}
