{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Evochora Assembly",
  "scopeName": "source.evo",
  "patterns": [
    {
      "include": "#main"
    }
  ],
  "repository": {
    "main": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#directives" },
        { "include": "#labels" },
        { "include": "#opcodes" },
        { "include": "#registers" },
        { "include": "#literals" },
        { "include": "#strings" },
        { "include": "#identifiers" }
      ]
    },
    "comments": {
      "name": "comment.line.number-sign.assembly",
      "match": "#.*$"
    },
    "directives": {
      "name": "keyword.control.directive.assembly",
      "match": "(?i)\\.(DEFINE|DIR|ENDM|ENDP|ENDR|IMPORT|MACRO|ORG|PLACE|PROC|REG|REPEAT|REQUIRE|SOURCE)\\b"
    },
    "labels": {
      "name": "entity.name.function.label.assembly",
      "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*):"
    },
    "opcodes": {
      "name": "keyword.control.instruction.assembly",
      "match": "(?i)\\b(NOP|WAIT|SETR|SETI|SETV|PUSH|PUSI|PUSV|POP|XCHG|DUP|SWAP|DROP|ROT|ADDR|ADDI|ADDS|SUBR|SUBI|SUBS|MULR|MULI|MULS|DIVR|DIVI|DIVS|MODR|MODI|MODS|NEGR|NEGS|ABSR|ABSS|INCR|INCS|DECR|DECS|MINR|MINI|MINS|MAXR|MAXI|MAXS|SGNR|SGNS|DOTR|DOTS|CRSR|CRSS|ANDR|ANDI|ANDS|ORR|ORI|ORS|XORR|XORI|XORS|NADR|NADI|NADS|NORR|NORI|NORS|EQUR|EQUI|EQUS|ADNR|ADNI|ADNS|ORNR|ORNI|ORNS|NOT|NOTS|SHLR|SHLI|SHLS|SHRR|SHRI|SHRS|ROTR|ROTI|ROTS|PCNR|PCNS|BSNR|BSNI|BSNS|VGTR|VGTI|VGTS|VSTR|VSTI|VSTS|VBLD|VBLS|B2VR|B2VI|B2VS|V2BR|V2BI|V2BS|RTRR|RTRI|RTRS|IFR|INR|IFI|INI|IFS|INS|LTR|GETR|LTI|GETI|LTS|GETS|GTR|LETR|GTI|LETI|GTS|LETS|IFTR|INTR|IFTI|INTI|IFTS|INTS|IFMR|INMR|IFMI|INMI|IFMS|INMS|IFPR|INPR|IFPI|INPI|IFPS|INPS|IFFR|INFR|IFFI|INFI|IFFS|INFS|IFVR|INVR|IFVI|INVI|IFVS|INVS|IFER|INER|IFSL|INSL|JMPR|JMPS|JMPI|CALL|RET|SCAN|SCNI|SCNS|SEEK|SEKI|SEKS|TURN|TRNI|TRNS|SYNC|NRG|NRGS|NTR|NTRS|DIFF|DIFS|POS|POSS|RAND|RNDS|FORK|FRKI|FRKS|ADPR|ADPI|ADPS|SPNR|SPNS|SNTR|SNTI|SNTS|RBIR|RBII|RBIS|GDVR|GDVS|SMR|SMRI|SMRS|GMR|GMRS|CMR|CMRI|CMRS|PEEK|PEKI|PEKS|POKE|POKI|POKS|PPKR|PPKI|PPKS|DPLS|DPLR|SKLS|SKLR|LRDS|LRDR|LSDS|LSDR|PUSL|POPL|DUPL|SWPL|DRPL|ROTL|CRLR|LRLR|SKJI|SKJR|SKJS|PSLI|LRLI)\\b"
    },
    "registers": {
      "name": "variable.language.register.assembly",
      "match": "(?i)%((PDR|PLR|FDR|FLR|SDR|SLR|DR|LR)\\d+|[A-Z_]+)"
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.other.molecule.assembly",
          "match": "(?i)\\b(DATA|ENERGY|STRUCTURE|CODE):(0x[0-9a-fA-F]+|0b[01]+|0o[0-7]+|-?\\d+)\\b"
        },
        {
          "name": "storage.type.assembly",
          "match": "(?i)\\b(DATA|ENERGY|STRUCTURE|CODE)(:)"
        },
        {
          "name": "constant.numeric.assembly",
          "match": "\\b(0x[0-9a-fA-F]+|0b[01]+|0o[0-7]+|-?\\d+)\\b"
        },
        {
          "name": "constant.other.vector.assembly",
          "match": "\\b-?\\d+(\\|-?\\d+)+\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.assembly",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.assembly",
          "match": "\\\\."
        }
      ]
    },
    "identifiers": {
      "name": "entity.name.function.assembly",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_\\.]*)\\b"
    }
  }
}
